# Copy this file to .env and adjust values as needed.
# .env is git-ignored — never commit real secrets.

POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=Lucas#1090$
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Used by the backend application to build the SQLAlchemy connection string
DATABASE_URL=postgresql+psycopg2://portfolio:change_me_locally@localhost:5432/portfolio

# Output directory for generated synthetic documents
DOCUMENT_OUTPUT_DIR=./datasets/generated

# Fixed seed for reproducible generation (Feature 0001, NFR1)
GENERATION_SEED=42
