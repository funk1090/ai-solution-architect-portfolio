# Copy to `.env` (git-ignored) and adjust. Read by `docker compose`.

# REQUIRED. Shared secret for the API; the frontend sends it server-side.
# Generate one with:  openssl rand -hex 24
API_KEY=change-me-to-a-real-secret

# PostgreSQL (local-development defaults; change them for anything shared).
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio

# LLM backend. Default: an Ollama already running on the host.
# With `--profile ollama` use:  OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3:latest

# Rate limiting, requests per minute per API key (0 disables a tier).
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_EXPENSIVE_PER_MINUTE=10
